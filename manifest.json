{
  "manifest_version": 3,
  "name": "得到知识红包伴侣",
  "version": "0.2.8",
  "description": "直接整理已领取的课程知识红包，无需先学习；显示官方到期日，并在得到网页阅读。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开得到知识红包",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dedao.cn/*"
      ],
      "js": [
        "bridge-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dedao.cn/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://baiyalab.com/projects/dedao-redpacket-web-extension",
  "host_permissions": [
    "https://m.igetget.com/*"
  ]
}
